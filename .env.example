# Development-only configuration. Copy to .env, which is git-ignored.
#
# Neither variable is a VITE_ variable, so neither is inlined into the bundle.
# Both are read in vite.config.ts, which runs in Node, and are used only to
# configure the dev server's proxy. Nothing here reaches the browser.

# Where `npm run dev` forwards /v1 and /health.
PIHOME_HUB_ORIGIN=http://127.0.0.1:5002

# The hub's relay key, which the dev proxy attaches to forwarded requests so you
# can develop against real relay state. Copy it from the hub's own .env:
#
#   grep PIHOME_RELAY_API_KEY ../pihome-hub/.env
#
# Leave it unset to see how the app behaves against an unauthenticated hub — it
# should report that the key was rejected, not show an empty list.
PIHOME_RELAY_API_KEY=
