# Development-only configuration. Copy to .env, which is git-ignored.
#
# Nothing here is a VITE_ variable, so nothing here is inlined into the bundle. It
# is read in vite.config.ts, which runs in Node, and is used only to configure the
# dev server's proxy. Nothing in this file reaches the browser.

# Where `npm run dev` forwards /v1 and /health.
PIHOME_HUB_ORIGIN=http://127.0.0.1:5002

# There is no key to set here, and that is the whole of the second variable this
# file used to have. The proxy attached the hub's relay key, which made development
# work with no account — and made the role on that account mean nothing, because the
# hub admits a valid key to every route. You log in on the page now:
#
#   pihome-hub-admin create roman --role operator
